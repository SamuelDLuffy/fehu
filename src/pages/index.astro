---
import Layout from "../layouts/Layout.astro";
import Reveal from "@/components/ui/reveal";
import BotoesFlutuantes from "@/components/BotoesFlutuantes.astro";
import Logo from "@/components/Logo.astro";

// Contatos reais extraídos do material do cliente
const whatsapp = "5531999501307";
const whatsappMsg = encodeURIComponent("Olá! Vim pelo site da FEHU e gostaria de solicitar um orçamento.");
const whatsappLink = `https://wa.me/${whatsapp}?text=${whatsappMsg}`;
// ⚠️ o material usa @fehuarteestrutura E @fehu_metal — confirmar com o cliente
const instagramLink = "https://instagram.com/fehu_metal";

const servicos = [
  {
    n: "1",
    icone: "🏗️",
    nome: "Estruturas e Coberturas",
    desc: "Estruturas metálicas, coberturas, toldos, pergolados e reforços estruturais.",
  },
  {
    n: "2",
    icone: "🚪",
    nome: "Serralheria Residencial",
    desc: "Portões, corrimãos, escadas, grades e fechamentos sob medida.",
  },
  {
    n: "3",
    icone: "🔧",
    nome: "Reformas e Manutenções",
    desc: "Reformas metálicas, reparos, ajustes estruturais, soldas e reforços.",
  },
  {
    n: "4",
    icone: "⚒️",
    nome: "Projetos Personalizados",
    desc: "Peças sob medida, arte em metal, estruturas personalizadas e projetos exclusivos.",
  },
  {
    n: "5",
    icone: "🏢",
    nome: "Comunicação Visual e ACM",
    desc: "Estruturas para fachadas, ACM, suportes metálicos e instalações comerciais.",
  },
  {
    n: "6",
    icone: "🚗",
    nome: "Estruturas Automotivas e Especiais",
    desc: "Suportes, proteções, reboques, engates e projetos especiais em metal.",
  },
];

const diferenciais = [
  { titulo: "Qualidade garantida", desc: "Segurança em cada projeto." },
  { titulo: "Acabamento profissional", desc: "Detalhes que fazem toda a diferença." },
  { titulo: "Prazos cumpridos", desc: "Compromisso com a entrega." },
  { titulo: "Atendimento personalizado", desc: "Cada projeto recebe atenção individual." },
  { titulo: "Soluções sob medida", desc: "Do briefing à instalação, tudo para o seu espaço." },
];

const etapas = [
  { n: "01", titulo: "Entendemos sua necessidade", desc: "Escutamos você para entender exatamente o que precisa." },
  { n: "02", titulo: "Planejamos a melhor solução", desc: "Desenvolvemos o projeto ideal com segurança, funcionalidade e qualidade." },
  { n: "03", titulo: "Executamos com qualidade", desc: "Utilizamos materiais de qualidade e mão de obra especializada." },
  { n: "04", titulo: "Entregamos o resultado", desc: "Compromisso com prazos, acabamento e sua satisfação." },
];
---

<Layout>
  <!-- Header -->
  <header class="fixed top-0 z-40 w-full border-b border-steel-800 bg-steel-950/90 backdrop-blur-md">
    <nav class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
      <a href="#" class="flex items-center gap-3">
        <Logo class="h-9 w-auto" />
        <span class="font-display text-2xl font-semibold uppercase tracking-widest text-paper">
          FE<span class="text-fehu-500">HU</span>
        </span>
      </a>
      <ul class="hidden gap-8 text-sm font-medium text-paper/70 md:flex">
        <li><a href="#servicos" class="hover:text-fehu-500 transition">Serviços</a></li>
        <li><a href="#processo" class="hover:text-fehu-500 transition">Como trabalhamos</a></li>
        <li><a href="#sobre" class="hover:text-fehu-500 transition">Quem somos</a></li>
        <li><a href="#contato" class="hover:text-fehu-500 transition">Contato</a></li>
      </ul>
      <a href={whatsappLink} data-ga-event="clique_whatsapp" data-ga-local="header"
        class="rounded-sm bg-fehu-500 px-5 py-2 text-sm font-bold uppercase text-steel-950 hover:bg-fehu-400 transition">
        Orçamento
      </a>
    </nav>
  </header>

  <!-- Hero -->
  <section class="relative flex min-h-screen items-center overflow-hidden pt-20">
    <div class="absolute inset-0 bg-gradient-to-br from-steel-950 via-steel-900 to-steel-800"></div>
    <div class="absolute -left-32 top-0 h-full w-1/2 -skew-x-12 bg-fehu-500/5"></div>
    <div class="relative mx-auto grid max-w-6xl gap-10 px-6 md:grid-cols-2 md:items-center">
      <Reveal from="left" client:load>
        <p class="mb-4 text-sm font-bold uppercase tracking-[0.25em] text-fehu-500">Arte & Estruturas em Metal</p>
        <h1 class="font-display text-5xl font-semibold uppercase leading-[1.02] text-paper md:text-7xl">
          Transformamos ideias em <span class="text-fehu-500">realidade</span>
        </h1>
        <p class="mt-6 max-w-md text-lg text-paper/70">
          Soluções metálicas com qualidade, segurança e acabamento profissional para residências, empresas e projetos personalizados.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a href={whatsappLink} data-ga-event="clique_whatsapp" data-ga-local="hero"
            class="rounded-sm bg-fehu-500 px-8 py-4 font-bold uppercase text-steel-950 hover:bg-fehu-400 transition">
            Solicite seu orçamento
          </a>
          <a href="#servicos" class="rounded-sm border border-paper/20 px-8 py-4 font-bold uppercase text-paper hover:border-fehu-500 hover:text-fehu-500 transition">
            Nossos serviços
          </a>
        </div>
        <p class="mt-10 flex items-center gap-2 text-sm text-paper/50">
          📍 Belo Horizonte, Congonhas e região · Orçamento sem compromisso · Atendimento em domicílio
        </p>
      </Reveal>
      <Reveal from="right" delay={0.15} className="relative hidden md:block" client:load>
        <div class="aspect-[4/5] border border-fehu-500/30 bg-gradient-to-tr from-steel-800 to-steel-700 shadow-2xl flex items-center justify-center">
          <span class="px-8 text-center font-display text-xl uppercase text-fehu-500/40">[ foto de projeto — fachada / móvel ]</span>
        </div>
        <div class="absolute -bottom-4 -left-4 h-full w-full border border-fehu-500/20 -z-10"></div>
      </Reveal>
    </div>
  </section>

  <!-- Serviços: as 3 frentes -->
  <section id="servicos" class="mx-auto max-w-6xl px-6 py-24">
    <Reveal className="mb-16 text-center" client:load>
      <p class="mb-3 text-sm font-bold uppercase tracking-[0.25em] text-fehu-500">O que fazemos</p>
      <h2 class="font-display text-4xl font-semibold uppercase text-paper md:text-5xl">Nossos serviços</h2>
    </Reveal>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {servicos.map((s, i) => (
        <Reveal delay={i * 0.08} client:load>
          <div class="group flex h-full gap-5 border border-steel-700 bg-steel-900 p-6 transition hover:border-fehu-500">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center bg-fehu-500 font-display text-xl font-semibold text-steel-950 [clip-path:polygon(25%_0,75%_0,100%_50%,75%_100%,25%_100%,0_50%)]">
              {s.n}
            </div>
            <div>
              <h3 class="mb-2 font-display text-lg font-semibold uppercase leading-tight text-paper">{s.nome}</h3>
              <p class="text-sm leading-relaxed text-paper/60">{s.desc}</p>
            </div>
          </div>
        </Reveal>
      ))}
    </div>
  </section>

  <!-- Diferenciais -->
  <section class="border-y border-steel-800 bg-steel-900 py-16">
    <div class="mx-auto grid max-w-6xl grid-cols-2 gap-8 px-6 md:grid-cols-5">
      {diferenciais.map((d, i) => (
        <Reveal delay={i * 0.1} className="text-center" client:load>
          <div>
            <p class="font-display text-lg font-semibold uppercase text-fehu-500">{d.titulo}</p>
            <p class="mt-2 text-sm text-paper/60">{d.desc}</p>
          </div>
        </Reveal>
      ))}
    </div>
  </section>

  <!-- Como trabalhamos -->
  <section id="processo" class="mx-auto max-w-6xl px-6 py-24">
    <Reveal className="mb-16 text-center" client:load>
      <p class="mb-3 text-sm font-bold uppercase tracking-[0.25em] text-fehu-500">Do briefing à instalação</p>
      <h2 class="font-display text-4xl font-semibold uppercase text-paper md:text-5xl">Como trabalhamos</h2>
    </Reveal>
    <div class="grid gap-6 md:grid-cols-4">
      {etapas.map((e, i) => (
        <Reveal delay={i * 0.12} client:load>
          <div class="h-full border-t-2 border-fehu-500 bg-steel-900 p-6">
            <p class="font-display text-4xl font-semibold text-fehu-500/40">{e.n}</p>
            <h3 class="mt-3 font-display text-lg font-semibold uppercase text-paper">{e.titulo}</h3>
            <p class="mt-2 text-sm text-paper/60">{e.desc}</p>
          </div>
        </Reveal>
      ))}
    </div>
  </section>

  <!-- Quem somos (placeholder — aguardando anexos "quem somos nós") -->
  <section id="sobre" class="bg-steel-900 py-24">
    <div class="mx-auto grid max-w-6xl gap-12 px-6 md:grid-cols-2 md:items-center">
      <Reveal from="left" client:load>
        <div class="aspect-square border border-fehu-500/20 bg-gradient-to-br from-steel-800 to-steel-700 flex items-center justify-center">
          <span class="px-8 text-center font-display text-lg uppercase text-fehu-500/40">[ foto oficina / equipe ]</span>
        </div>
      </Reveal>
      <Reveal from="right" client:load>
        <p class="mb-3 text-sm font-bold uppercase tracking-[0.25em] text-fehu-500">Quem somos</p>
        <h2 class="font-display text-4xl font-semibold uppercase text-paper md:text-5xl">Excelência em cada detalhe</h2>
        <p class="mt-6 text-lg leading-relaxed text-paper/70">
          A FEHU nasceu da paixão por criar, transformar e construir.
        </p>
        <p class="mt-4 leading-relaxed text-paper/60">
          Atuamos com fabricação, reforma e instalação de estruturas metálicas, sempre buscando unir qualidade, funcionalidade e acabamento profissional.
        </p>
        <p class="mt-4 leading-relaxed text-paper/60">
          Nossa experiência vem de anos acompanhando o setor metalúrgico e da vivência prática em projetos de diversos portes, desde pequenas reformas até estruturas mais elaboradas.
        </p>
        <p class="mt-4 border-l-2 border-fehu-500 pl-4 leading-relaxed text-fehu-400">
          Cada projeto recebe atenção individual para garantir que o resultado final atenda exatamente às necessidades do cliente.
        </p>
      </Reveal>
    </div>
  </section>

  <!-- CTA final -->
  <section id="contato" class="bg-fehu-500 py-24 text-center text-steel-950">
    <Reveal className="mx-auto max-w-2xl px-6" client:load>
      <h2 class="font-display text-4xl font-semibold uppercase md:text-6xl">Vamos transformar sua ideia em realidade?</h2>
      <p class="mt-6 text-lg font-medium text-steel-950/80">
        Entre em contato e solicite seu orçamento — sem compromisso, com atendimento em domicílio.
      </p>
      <a href={whatsappLink} data-ga-event="clique_whatsapp" data-ga-local="cta_final"
        class="mt-8 inline-block rounded-sm bg-steel-950 px-10 py-4 font-bold uppercase text-fehu-500 hover:bg-steel-900 transition">
        (31) 99950-1307
      </a>
    </Reveal>
  </section>

  <!-- Footer -->
  <footer class="bg-steel-950 py-10 text-center text-sm text-paper/40">
    <div class="mb-3 flex justify-center"><Logo class="h-12 w-auto" /></div>
    <p class="font-display text-2xl font-semibold uppercase tracking-widest text-paper">FE<span class="text-fehu-500">HU</span></p>
    <p class="mt-1 text-xs uppercase tracking-widest text-paper/50">Arte & Estruturas em Metal</p>
    <p class="mt-3">Congonhas — MG · Belo Horizonte — MG · (31) 99950-1307 · @fehu_metal</p>
    <p class="mt-4 text-xs text-paper/25">© 2026 FEHU Arte & Estruturas em Metal.</p>
  </footer>

  <BotoesFlutuantes whatsappLink={whatsappLink} instagramLink={instagramLink} />
</Layout>
